# Root reference only. Copy the relevant block into the file for each app:
#   apps/web/.env.local   (Next.js — also set these in the Vercel dashboard)
#   apps/server/.env      (game server — also set these on your server host, e.g. Render)

# ---- apps/web ----
NEXT_PUBLIC_GAME_SERVER_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- apps/server ----
PORT=4000
# Comma-separated list of allowed browser origins (your Vercel URL + custom domain)
CLIENT_ORIGIN=http://localhost:3000
SUPABASE_URL=https://bpklcnwrivrpisajzuyv.supabase.co
# SECRET: Supabase dashboard > Project Settings > API Keys > service_role / secret key.
# Server-side only. Never put this in apps/web or any NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=
